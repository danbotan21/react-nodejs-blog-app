MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Blog
JWT_SECRET=any-long-random-string
PORT=3001
# Frontend address allowed by CORS (default: any)
CLIENT_URL=http://localhost:5173
# Optional: DNS servers used to resolve the database address (fixes querySrv ECONNREFUSED on some Windows setups)
DNS_SERVERS=
